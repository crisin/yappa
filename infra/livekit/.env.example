# Copy to infra/livekit/.env (gitignored) — on the server next to home.yml, and on the dev
# machine so `cargo xtask livekit token` can sign tokens with the same key pair.
#
# Generate a pair on the server:
#   docker run --rm livekit/livekit-server:v1.13.8 generate-keys
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# The public host name of the server, without scheme — e.g. a MyFRITZ! address.
YAPPA_DOMAIN=
